ModalScreen {
    align: center middle;
}

#dialog {
    width: 80%;
    max-width: 110;
    height: auto;
    max-height: 85%;
    padding: 1 2;
    border: thick $primary;
    background: $surface;
}

#dialog .title {
    text-style: bold;
}

#dialog VerticalScroll {
    height: auto;
    max-height: 20;
    margin: 1 0;
}

#dialog Horizontal {
    height: auto;
    align-horizontal: right;
}

#dialog Button {
    margin-left: 2;
}

#dialog Input {
    margin-bottom: 1;
}

#progress {
    margin-top: 1;
}

#log {
    height: 8;
    margin: 0 0 1 0;
    border: round $primary-darken-2;
}

#scanning {
    height: 1;
    color: $accent;
}

#status {
    height: auto;
    padding: 0 1;
}

Tabs {
    margin-bottom: 1;
}

DataTable {
    height: 1fr;
}

#dialog.tall {
    height: 92%;
}

#dialog.tall #settings-form {
    height: 1fr;
    max-height: 100%;
}

#settings-form .hint {
    color: $text-muted;
    margin-top: 1;
}

#ai-auto-row,
#ai-share-row {
    height: 3;
    align-horizontal: left;
}

#ai-status {
    margin-top: 1;
}

Screen {
    layers: base overlay;
}

#ai-panel {
    layer: overlay;
    dock: right;
    width: 42;
    height: 1fr;
    margin: 1 0 2 0;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

#ai-panel .title {
    text-style: bold;
}

#ai-panel-scroll {
    height: 1fr;
    margin: 1 0;
    scrollbar-gutter: stable;
}

#ai-panel-buttons {
    height: 3;
    align-horizontal: right;
}

#ai-panel-buttons Button {
    margin-left: 1;
}
